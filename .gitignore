server/data/workflows.json
server/data/activity.json
server/data/*.tar.gz
*.tmp
!server/data/.gitkeep

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
