# Dependencies
node_modules/
.pnp
.pnp.js
bun.lock*


# Production build outputs
dist/
build/
out/

# Environment files and credentials (NEVER commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

