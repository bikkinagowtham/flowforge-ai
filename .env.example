# ==============================================================================
# FlowForge AI Environment Configuration (Nebius x NVIDIA Global AI Hackathon 2026)
# ==============================================================================
# Copy this file to .env and provide your actual Nebius Token Factory credentials.
# NOTE: DO NOT commit your actual .env file or API key into git!

# Server Port
PORT=3001

# Nebius Token Factory API Configuration
# Base URL for Nebius Token Factory OpenAI-compatible API
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Nebius API Key (Obtain from https://tokenfactory.nebius.com or Nebius AI Studio)
# Leave empty to start the app in clearly-labeled DEMO MODE with verifiable fallbacks.
NEBIUS_API_KEY=your_nebius_api_key_here

# NVIDIA Open-Source Model on Nebius Token Factory
# Eligible options include:
# - nebius/nvidia/Nemotron-3_5-Lightning (Recommended: fast agentic workflow reasoning)
# - nebius/nvidia/nemotron-3-super-120b-a12b (MoE complex reasoning)
# - nebius/nvidia/Nemotron-3-Ultra-550b-a55b (Deep planning and large context)
# - nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_MODEL=nebius/nvidia/Nemotron-3_5-Lightning

# Execution Environment
NODE_ENV=development
